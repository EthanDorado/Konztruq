)


# ============================================================
# HELPER FUNCTIONS
# ============================================================

def money(amount):
    """Formats a number as Philippine pesos."""
    return f"PHP {amount:,.2f}"


def format_date(value):
    """
    Converts the database timestamp into a readable
    Philippine time (UTC+8).
    """

    try:
        moment = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        moment = moment.astimezone(timezone(timedelta(hours=8)))
        return moment.strftime("%b %d, %Y %I:%M %p")

    except Exception:
        return str(value)


def safe_text(value):
    """Escapes text typed by users and keeps its line breaks."""
    return escape(str(value)).replace("\n", "<br>")


def get_status_class(status):
    """
    Chooses the color style for an order status.

    pending / confirmed / preparing   -> orange (waiting on the store)
    ready / out for delivery / done   -> blue
    cancelled                         -> red
    """

    if status == OrderService.STATUS_CANCELLED:
        return "status-cancelled"

    if status in (
        OrderService.STATUS_PENDING,
        OrderService.STATUS_CONFIRMED,
        OrderService.STATUS_PREPARING
    ):
        return "status-waiting"

    return "status-progress"


# ============================================================
# SERVICES
# ============================================================

cart_service = CartService()
order_service = OrderService()
delivery_service = DeliveryService()


def cancel_order_and_restore(order, return_items):
    """
    Cancels one order and, if the customer wants, puts its items
    back in the cart.

    The order is cancelled FIRST. If putting the items back fails,
    the order is still cancelled and the customer is told, so the
    same items can never be ordered twice by accident.

    Args:
        order (dict): One order from OrderService.
        return_items (bool): True to put the items back in the cart.

    Returns:
        tuple: (success, message) where success is True when the
        order was cancelled.
    """

    try:
        order_service.cancel_order(order["order_id"])

    except Exception as error:
        return False, f"Could not cancel the order: {error}"

    if not return_items:
        return True, "The order was cancelled."

    try:
        cart = cart_service.get_or_create_cart(TEST_CUSTOMER_ID)

        for item in order["items"]:
            cart_service.add_item(
                cart["cart_id"],
                item["listing_id"],
                item["quantity"]
            )

    except Exception as error:
        return True, (
            f"The order was cancelled, but some items could not be put "
            f"back in your cart ({error}). Please add them again from "
            f"the marketplace."
        )

    return True, "The order was cancelled and its items are back in your cart."


# ============================================================
# HEADER
# ============================================================

st.markdown(
    '<div class="main-title">My Orders</div>',
    unsafe_allow_html=True
)


# ============================================================
# LOAD ORDERS AND DELIVERY BOOKINGS
# ============================================================

try:
    orders = order_service.get_customer_orders(TEST_CUSTOMER_ID)

except Exception as error:
    st.error(f"Could not load your orders: {error}")
    st.stop()

try:
    bookings = delivery_service.get_bookings_for_orders(
        [order["order_id"] for order in orders]
    )

except Exception as error:
    st.error(f"Could not load your delivery bookings: {error}")
    bookings = {}

# Orders created a moment ago (set by the Checkout page).
# pop() removes it so the banner shows only once.
recent_order_ids = set(st.session_state.pop("last_order_ids", []))

# Order that was just booked (set by the Book Delivery page).
last_booked_order_id = st.session_state.pop("last_booked_order_id", None)

# Message from a cancellation done a moment ago.
cancel_notice = st.session_state.pop("cancel_notice", None)

if recent_order_ids:
    st.success(
        f"{len(recent_order_ids)} order(s) created. "
        f"Your receipt(s) are shown below."
    )

if last_booked_order_id:
    st.success("Your delivery has been booked.")

if cancel_notice:
    st.info(cancel_notice)
    st.page_link("pages/1_Cart.py", label="Go to my cart")

if not orders:
    st.info("You have no orders yet.")
    st.page_link("pages/0_Materials.py", label="Go to the Marketplace")
    st.stop()

# Orders that still need a vehicle booking. Each order's fulfillment
# object answers requires_booking() in its own way (polymorphism).
waiting_orders = [
    order for order in orders
    if Fulfillment.create(order["fulfillment_type"]).requires_booking()
    and order["status"] == OrderService.STATUS_PENDING
    and order["order_id"] not in bookings
]

if waiting_orders:
    st.warning(
        f"{len(waiting_orders)} delivery order(s) still need a "
        f"vehicle booking."
    )
    st.page_link("pages/4_Book_Delivery.py", label="Book delivery now")


# ============================================================
# ORDER RECEIPTS (ONE PER HARDWARE STORE)
# ============================================================

for order in orders:

    order_id = order["order_id"]

    # POLYMORPHISM: this is a PickupFulfillment or a
    # DeliveryFulfillment object. The page calls the same methods
    # on it, and the object decides what to answer.
    fulfillment = Fulfillment.create(order["fulfillment_type"])

    booking = bookings.get(order_id)

    status_text = OrderService.STATUS_TEXT.get(
        order["status"],
        str(order["status"]).title()
    )

    if order["status"] == OrderService.STATUS_PENDING:
        status_text += fulfillment.get_pending_note(booking is not None)

    status_class = get_status_class(order["status"])

    # A short, readable reference taken from the order ID.
    order_ref = str(order_id)[:8].upper()

    # An order can be cancelled while it is pending and has no
    # delivery booking.
    can_cancel = (
        order["status"] == OrderService.STATUS_PENDING
        and booking is None
    )

    with st.container(border=True):

        st.markdown(
            f'<div class="store-name">🏪 {escape(order["store_name"])}</div>',
            unsafe_allow_html=True
        )

        new_tag = ""
        if order_id in recent_order_ids or order_id == last_booked_order_id:
            new_tag = '  <span class="new-tag">NEW</span>'

        st.markdown(
            f'<div class="order-ref">Order #{order_ref}  ·  '
            f'{escape(format_date(order["created_at"]))}'
            f'{new_tag}</div>',
            unsafe_allow_html=True
        )

        st.markdown(
            f'<div class="{status_class}">'
            f'Status: {escape(status_text)}'
            f'</div>',
            unsafe_allow_html=True
        )

        st.markdown(
            f'<div><b>Receipt Name:</b> '
            f'{escape(order["receipt_name"])}</div>',
            unsafe_allow_html=True
        )

        # ----------------------------------------------------
        # HOW THE ORDER IS RECEIVED
        # ----------------------------------------------------

        st.write(fulfillment.get_receipt_heading(order["address"]))

        if fulfillment.requires_booking():

            if booking:

                if booking["delivery_fee"] <= 0:
                    fee_text = "To be quoted"
                else:
                    fee_text = money(booking["delivery_fee"])

                st.markdown(
                    f'<div class="delivery-box">'
                    f'<b>🚚 Delivery booking</b><br>'
                    f'<b>Vehicle:</b> {escape(booking["vehicle_name"])}<br>'
                    f'<b>Pickup location:</b> '
                    f'{safe_text(booking["pickup"].get_short_text())}<br>'
                    f'<b>Delivery location:</b> '
                    f'{safe_text(booking["delivery"].get_short_text())}<br>'
                    f'<b>Delivery fee:</b> {escape(fee_text)}<br>'
                    f'<b>Delivery status:</b> '
                    f'{escape(DeliveryService.get_status_text(booking["status"]))}'
                    f'</div>',
                    unsafe_allow_html=True
                )

                # Show the saved delivery location on a map.
                delivery_place = booking["delivery"]

                if delivery_place.has_coordinates():

                    with st.expander("Show delivery location on the map"):

                        st.map(
                            pd.DataFrame({
                                "lat": [delivery_place.latitude],
                                "lon": [delivery_place.longitude]
                            }),
                            zoom=15
                        )

                        st.markdown(
                            f"[Open in OpenStreetMap]"
                            f"({delivery_place.get_map_url()})"
                        )

            elif order["status"] == OrderService.STATUS_PENDING:

                st.markdown(
                    '<div class="needs-booking">'
                    '🚚 Delivery booking needed'
                    '</div>',
                    unsafe_allow_html=True
                )

        # ----------------------------------------------------
        # ITEMS
        # ----------------------------------------------------

        for item in order["items"]:

            st.divider()

            st.markdown(
                f'<b>{escape(item["product_name"])}</b>',
                unsafe_allow_html=True
            )

            st.write(
                f"{money(item['unit_price'])} × {item['quantity']} "
                f"({item['unit']})  =  **{money(item['subtotal'])}**"
            )

        st.divider()

        st.markdown(
            f'<div class="order-total">'
            f'Total: {money(order["total_amount"])}'
            f'</div>',
            unsafe_allow_html=True
        )

        # ----------------------------------------------------
        # CANCEL THIS ORDER
        # ----------------------------------------------------

        if can_cancel:

            with st.expander("Cancel this order"):

                return_items = st.checkbox(
                    "Put the items back in my cart",
                    value=True,
                    key=f"return_{order_id}"
                )

                if st.button(
                    "Yes, cancel this order",
                    key=f"cancel_{order_id}"
                ):

                    success, message = cancel_order_and_restore(
                        order,
                        return_items
                    )

                    if success:
                        st.session_state.cancel_notice = message
                        st.rerun()
                    else:
                        st.error(message)

st.page_link("pages/0_Materials.py", label="Continue Shopping")